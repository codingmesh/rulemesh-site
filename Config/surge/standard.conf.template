[General]
dns-server = system
encrypted-dns-server = https://cloudflare-dns.com/dns-query
encrypted-dns-follow-outbound-mode = true
ipv6 = false

[Proxy]
REPLACE-ME = http, replace.invalid, 1

[Proxy Group]
RuleMesh-Nodes = select,include-all-proxies=true
RuleMesh-ai = select,RuleMesh-Nodes,DIRECT
RuleMesh-anthropic = select,RuleMesh-ai,RuleMesh-Nodes,DIRECT
RuleMesh-openai = select,RuleMesh-ai,RuleMesh-Nodes,DIRECT
RuleMesh-gemini = select,RuleMesh-ai,RuleMesh-Nodes,DIRECT
