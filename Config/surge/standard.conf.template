RuleMesh-apple = select,DIRECT,RuleMesh-Nodes
RuleMesh-google = select,RuleMesh-Nodes,DIRECT
RuleMesh-microsoft = select,DIRECT,RuleMesh-Nodes
RuleMesh-games = select,RuleMesh-Nodes,DIRECT
RuleMesh-downloads = select,RuleMesh-Nodes,DIRECT
RuleMesh-china = select,DIRECT,RuleMesh-Nodes
RuleMesh-private = select,DIRECT,RuleMesh-Nodes
RuleMesh-fallback = select,RuleMesh-Nodes,DIRECT

