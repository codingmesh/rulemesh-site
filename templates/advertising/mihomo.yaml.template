# Complete template: replace the entire proxies/provider input using config compose.
proxies:
  - name: __RULEMESH_NODE__
    type: __RULEMESH_NODE_TYPE__
    server: __RULEMESH_SERVER__
    port: __RULEMESH_PORT__
ipv6: false
dns:
  enable: true
  ipv6: false
  enhanced-mode: redir-host
  default-nameserver:
    - 1.1.1.1
    - 8.8.8.8
  proxy-server-nameserver:
    - system
  nameserver:
    - https://cloudflare-dns.com/dns-query#RuleMesh-Nodes
  direct-nameserver:
    - system
  nameserver-policy:
    +.local:
      - system
    +.lan:
      - system
    rule-set:RuleMesh-Data-private:
      - system
    rule-set:RuleMesh-Data-bilibili:
      - system
    rule-set:RuleMesh-Data-apple-cn:
      - system
    rule-set:RuleMesh-Data-icloud:
      - system
    rule-set:RuleMesh-Data-apple-music:
      - system
    rule-set:RuleMesh-Data-apple-tv:
      - system
    rule-set:RuleMesh-Data-onedrive:
      - system
    rule-set:RuleMesh-Data-steam-cn:
      - system
    rule-set:RuleMesh-Data-apple:
      - system
    rule-set:RuleMesh-Data-microsoft:
      - system
    rule-set:RuleMesh-Data-cdn-cn:
      - system
    rule-set:RuleMesh-Data-china:
      - system
    rule-set:RuleMesh-Data-china.extra:
      - system
mode: rule
proxy-groups:
  - name: RuleMesh-Nodes
    type: select
    proxies:
      - __RULEMESH_NODE__
  - name: RuleMesh-anthropic
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-openai
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-gemini
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-ai-other
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-telegram
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-social
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-youtube
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-netflix
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-streaming
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-developer
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-apple
    type: select
    proxies:
      - DIRECT
      - RuleMesh-Nodes
  - name: RuleMesh-google
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-microsoft
    type: select
    proxies:
      - DIRECT
      - RuleMesh-Nodes
  - name: RuleMesh-games
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-downloads
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-china
    type: select
    proxies:
      - DIRECT
      - RuleMesh-Nodes
  - name: RuleMesh-private
    type: select
    proxies:
      - DIRECT
      - RuleMesh-Nodes
  - name: RuleMesh-advertising
    type: select
    proxies:
      - REJECT
      - RuleMesh-Nodes
      - DIRECT
  - name: RuleMesh-fallback
    type: select
    proxies:
      - RuleMesh-Nodes
      - DIRECT
