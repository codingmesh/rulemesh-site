# RuleMesh complete Shadowrocket configuration; target remains experimental until runtime validation.
# Nodes remain in Home subscriptions. Service groups select node-selection, PROXY or DIRECT.
# Imported rule atoms retain upstream licenses; see THIRD_PARTY_NOTICES.md.
[General]
# Local preview: no public automatic update address.
dns-server = https://cloudflare-dns.com/dns-query#proxy
dns-direct-system = true
dns-fallback-system = false
private-ip-answer = true
ipv6 = false
prefer-ipv6 = false
udp-policy-not-supported-behaviour = REJECT

[Proxy]
# Nodes stay in the user's existing Home subscriptions; no credentials are embedded.

[Proxy Group]
node-selection = select,policy-regex-filter=.*
anthropic = select,node-selection,PROXY,DIRECT
openai = select,node-selection,PROXY,DIRECT
gemini = select,node-selection,PROXY,DIRECT
ai-other = select,node-selection,PROXY,DIRECT
telegram = select,node-selection,PROXY,DIRECT
social = select,node-selection,PROXY,DIRECT
youtube = select,node-selection,PROXY,DIRECT
netflix = select,node-selection,PROXY,DIRECT
streaming = select,node-selection,PROXY,DIRECT
developer = select,node-selection,PROXY,DIRECT
apple = select,DIRECT,node-selection,PROXY
google = select,node-selection,PROXY,DIRECT
microsoft = select,DIRECT,node-selection,PROXY
games = select,node-selection,PROXY,DIRECT
downloads = select,node-selection,PROXY,DIRECT
china = select,DIRECT,node-selection,PROXY
private = select,DIRECT,node-selection,PROXY
advertising = select,REJECT,node-selection,PROXY,DIRECT
fallback = select,node-selection,PROXY,DIRECT

